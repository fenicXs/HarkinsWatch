# Copy to .env and fill in. Key names only; never commit real values.
# Settings with a default are commented out; uncomment to override.

# --- Database ------------------------------------------------------------------------------
# From this PC (tools, tests). Compose overrides the host to `postgres:5432` for the containers.
DATABASE_URL=
TEST_DATABASE_URL=
POSTGRES_PASSWORD=

# --- Telegram ------------------------------------------------------------------------------
# A NEW bot made in BotFather; not the legacy bot's token.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USER_ID=

# --- Logging and scheduling (defaults shown) -----------------------------------------------
# LOG_LEVEL=INFO
# CHECK_INTERVAL_S=1800
# FAST_INTERVAL_S=60
# FAST_WINDOW_H=72
# POLL_JITTER_PCT=20
# JOB_LOCK_TIMEOUT_S=900
# CHAIN_REQUEST_BUDGET_PER_MIN=10

# --- LLM: seat-map vision (M4) -------------------------------------------------------------
