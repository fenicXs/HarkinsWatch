# Copy to .env and fill in. Key names only; never commit real values.
# Settings with a default are commented out; uncomment to override.

# --- Database ------------------------------------------------------------------------------
# From this PC (tools, tests), e.g. postgresql+asyncpg://showwatch:<password>@127.0.0.1:5433/showwatch
# Use 127.0.0.1, not localhost: on Windows `localhost` tries IPv6 first and every connection
# waits about 2 s. Compose overrides the host to `postgres:5432` for the containers.
DATABASE_URL=
TEST_DATABASE_URL=
# Letters and digits only: the password is placed inside a URL, so @ / : # break it.
POSTGRES_PASSWORD=

# --- Telegram ------------------------------------------------------------------------------
# A NEW bot made in BotFather (message @BotFather, send /newbot); not the old bot's token.
# ADMIN_TELEGRAM_USER_ID is your own numeric Telegram id (message @userinfobot to see it).
# Without a real token the bot container exits, because Telegram rejects it.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_USER_ID=

# --- Logging and scheduling (defaults shown) -----------------------------------------------
# LOG_LEVEL=INFO
# CHECK_INTERVAL_S=1800
# FAST_INTERVAL_S=60
# FAST_WINDOW_H=72
# SIGNAL_INTERVAL_S=300
# SIGNAL_BROWSER_CHANNEL=chrome
# SIGNAL_HEADLESS=false
# POLL_JITTER_PCT=20
# JOB_LOCK_TIMEOUT_S=900
# CHAIN_REQUEST_BUDGET_PER_MIN=10

# --- LLM: seat-map vision (M4) -------------------------------------------------------------
LLM_VISION_BASE_URL=
LLM_VISION_MODEL=
LLM_VISION_API_KEY=
# LLM_VISION_TIMEOUT_S=45
# LLM_VISION_COORD_ORDER=yx
# LLM_VISION_COORD_SCALE=1000
LLM_VISION_FALLBACK_BASE_URL=
LLM_VISION_FALLBACK_MODEL=
LLM_VISION_FALLBACK_API_KEY=
# LLM_VISION_FALLBACK_TIMEOUT_S=45
# LLM_VISION_FALLBACK_COORD_ORDER=yx
# LLM_VISION_FALLBACK_COORD_SCALE=1000

# --- LLM: intent parsing and title matching (M6) -------------------------------------------
LLM_TEXT_BASE_URL=
LLM_TEXT_MODEL=
LLM_TEXT_API_KEY=
# LLM_TEXT_TIMEOUT_S=45
LLM_TEXT_FALLBACK_BASE_URL=
LLM_TEXT_FALLBACK_MODEL=
LLM_TEXT_FALLBACK_API_KEY=
# LLM_TEXT_FALLBACK_TIMEOUT_S=45
